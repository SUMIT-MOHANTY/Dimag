# =============================================================================
# Open LMS - Git Ignore
# =============================================================================

# -----------------------------------------------------------------------------
# Python / Backend
# -----------------------------------------------------------------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# Environment variables
.env
.env.local
.env.*.local
!.env.example

# Database files
*.db
*.sqlite
*.sqlite3
app.db

# Alembic
alembic/versions/*
!alembic/versions/.gitkeep

# Pytest
.pytest_cache/
.coverage
htmlcov/
.tox/

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/
log/

# -----------------------------------------------------------------------------
# Node.js / Frontend
# -----------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/
*.local

# Testing
coverage/

# Vite
.vite/

# TypeScript
*.tsbuildinfo

# -----------------------------------------------------------------------------
# SSL Certificates
# -----------------------------------------------------------------------------

# Never commit SSL certificates
nginx/ssl/*.pem
nginx/ssl/*.crt
nginx/ssl/*.key
nginx/ssl/*.csr
!nginx/ssl/.gitkeep

# -----------------------------------------------------------------------------
# Uploads / Media
# -----------------------------------------------------------------------------

# User uploads
uploads/*
!uploads/.gitkeep

# Media files
media/

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------

# Docker volumes
data/

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
*.bak
*.backup

# Local development
*.local
local/

# Secrets
secrets/
*.secret

# Dsuite internal agent communication & synchronization
.agent/
.agent
.agent_worktrees/
.agent_worktrees
.agent_history/
.agent_history
.agent_ipc/
.agent_ipc
.agent_signals/
.agent_signals
.agent_initialized
.package_deps_hash
**/node_modules/**
