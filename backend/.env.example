# =============================================================================
# Open LMS - Backend Environment Configuration
# =============================================================================

# === APPLICATION ===
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-secure-random-32-char-string
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:80"]

# === DATABASE ===
# SQLite (default for development)
DATABASE_URL=sqlite+aiosqlite:///./app.db
# PostgreSQL (for production/Docker)
# DATABASE_URL=postgresql+asyncpg://openlms:changeme@db:5432/openlms
POSTGRES_PASSWORD=changeme

# === AUTHENTICATION ===
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# === ADMIN SEED ===
ADMIN_EMAIL=admin@openlms.dev
ADMIN_PASSWORD=Admin@SecurePass1

# === REDIS (optional — in-memory fallback if unset) ===
# REDIS_URL=redis://localhost:6379/0

# === EMAIL (optional — console fallback if unset) ===
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# FROM_EMAIL=noreply@yourdomain.com

# === FILE STORAGE (optional — local filesystem fallback if unset) ===
# S3_BUCKET_NAME=openlms-media
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# S3_ENDPOINT_URL=https://s3.amazonaws.com

# === RATE LIMITING ===
RATE_LIMIT_AUTH=10/minute

# === UPLOADS ===
MAX_UPLOAD_SIZE_MB=100
